* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
    color: white;
    scroll-behavior: smooth;
}

/* HEADER */
header {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

header h1 {
    font-size: 50px;
    margin-bottom: 15px;
}

header p {
    font-size: 24px;
    color: cyan;
}

/* BUTTONS */
.buttons {
    margin-top: 20px;
}

.btn {
    display: inline-block;
    padding: 12px 20px;
    margin: 10px;
    background: cyan;
    color: black;
    border-radius: 30px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    transform: scale(1.1);
}

.secondary {
    background: white;
}

/* NAVBAR */
nav {
    position: sticky;
    top: 0;
    background: rgba(0,0,0,0.8);
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    margin: 15px;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    color: cyan;
}

/* CARDS */
.card {
    max-width: 1000px;
    margin: 40px auto;
    padding: 30px;
    background: rgba(255,255,255,0.1);
    border-radius: 15px;
    backdrop-filter: blur(10px);
}

h2 {
    margin-bottom: 20px;
    color: cyan;
}

/* EDUCATION */
.edu-box {
    margin-bottom: 20px;
}

/* SKILLS */
.skills-container span {
    display: inline-block;
    margin: 10px;
    padding: 10px 20px;
    background: rgba(255,255,255,0.2);
    border-radius: 20px;
    transition: 0.3s;
}

.skills-container span:hover {
    background: cyan;
    color: black;
}

/* PROJECTS */
.project-box {
    margin: 20px 0;
    padding: 20px;
    border-radius: 10px;
    background: rgba(255,255,255,0.08);
}

.project-box a {
    color: cyan;
    text-decoration: none;
}

/* FOOTER */
footer {
    text-align: center;
    padding: 20px;
    background: black;
}

/* SCROLL ANIMATION */
.reveal {
    opacity: 0;
    transform: translateY(60px);
    transition: all 1s ease;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* RESPONSIVE */
@media(max-width:768px) {

    header h1 {
        font-size: 35px;
    }

    nav a {
        display: block;
        margin: 10px;
    }

    .card {
        margin: 20px;
    }
}
